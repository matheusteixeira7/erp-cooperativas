{
  "descricao": "Contratos tRPC v11. Um router por domínio em apps/web/server/trpc/routers/<router>.ts, composto em root.ts. Todo input e output é zod. 'protected' = protectedProcedure; 'roles' vira middleware requireRole. Campos de input em camelCase; cooperativeId NUNCA é input (RN-027). Formato de dinheiro no wire: number com 2 casas.",
  "convencoes": {
    "nomes": "router plural em inglês; query = substantivo/adjetivo (list, byId, byDate, simulate); mutation = verbo (create, update, close).",
    "paginacao": "cursor nullish + limit 1..100 (default 50) em toda list que pode crescer.",
    "erros": "ver 50-api/erros.json; nunca Error genérico.",
    "datas": "LocalDate 'YYYY-MM-DD'; Period 'YYYY-MM'; timestamps ISO com fuso.",
    "rest_pdf": "Campo pdf_rota mostra a rota REST equivalente do protótipo. Só histórico.",
    "idiomas": "Identificadores em inglês (DEC-004). O campo mensagem_pt em erros.json é o único texto que chega ao usuário e é sempre pt-BR."
  },
  "schemas_compartilhados": {
    "Member": "{ id, name, cpfMasked, pixKey?(manager), phone?, admittedOn, leftOn?, active, inssWithheld }",
    "Attendance": "{ memberId, memberName, present, note? }",
    "SaleItemInput": "{ materialTypeId, condition: MaterialCondition, weightKg, pricePerKg, baleCount? }",
    "Sale": "{ id, buyer:{id,name}, soldOn, totalAmount, totalWeightKg, items:[{ materialType:{id,name}, condition, weightKg, pricePerKg, subtotal }], invoiceNumber?, createdAt }",
    "Expense": "{ id, description, category?, amount, incurredOn, createdAt }",
    "Advance": "{ id, member:{id,name}, kind, description, amount, grantedOn, status, deductedInPayoutId? }",
    "PayoutSettings": "{ effectiveFrom, legalReserveRate, fatesRate, otherFundsRate, inssRate, negativeBalancePolicy, includeMembersLeftInPeriod }",
    "PayoutSummary": "{ period, grossRevenue, totalPurchases, totalExpenses, surplus, legalReserveAmount, fatesAmount, otherFundsAmount, distributableSurplus, totalWorkedDays, dayValue, distributedTotal, roundingResidual, inssTotal, settings: PayoutSettings }",
    "PayoutItem": "{ memberId, memberName, workedDays, grossAmount, inssBase, inssRate, inssAmount, deductionsAmount, netAmount, carryOverDebt, paidAt? }",
    "PayoutResult": "{ summary: PayoutSummary, items: PayoutItem[] }",
    "Payout": "PayoutResult & { id, status, closedAt, closedBy:{id,name}, reopenedAt?, reopenReason? }",
    "Supplier": "{ id, kind: SupplierKind, name, cpfMasked?, cnpj?, pixKey?(manager), phone?, active }",
    "PurchaseItemInput": "{ materialTypeId, condition: MaterialCondition, weightKg, pricePerKg }",
    "Purchase": "{ id, supplier:{id,name,kind}, purchasedOn, totalAmount, totalWeightKg, paymentMethod, paidOn?, items:[{ materialType:{id,name}, condition, weightKg, pricePerKg, subtotal }], note?, createdAt }"
  },
